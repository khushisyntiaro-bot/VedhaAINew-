# ============================================================================
# VedhaAI .htaccess Configuration
# Purpose: SEO optimization, security, performance, and redirects
# ============================================================================

# Enable mod_rewrite
<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Remove www from URL (optional - change if you prefer www)
  # RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  # RewriteRule ^(.*)$ http://%1/$1 [R=301,L]
  
  # Redirect HTTP to HTTPS (uncomment when SSL is available)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  
  # Rewrite all requests to index.html for React Router (SPA)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [QSA,L]
</IfModule>

# ============================================================================
# GZIP Compression - Reduce file sizes for faster loading
# ============================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/x-font-ttf
  AddOutputFilterByType DEFLATE font/opentype
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
  
  # Remove duplicate headers
  Header append Vary: Accept-Encoding
</IfModule>

# ============================================================================
# Browser Caching - Improve repeat visitor performance
# ============================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Images
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # CSS and JavaScript
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  
  # Fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/x-font-ttf "access plus 1 year"
  
  # Documents
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  
  # Default
  ExpiresDefault "access plus 30 days"
</IfModule>

# ============================================================================
# Security Headers
# ============================================================================

# Prevent clickjacking attacks
Header always append X-Frame-Options "SAMEORIGIN"

# Enable XSS protection in older browsers
Header always append X-XSS-Protection "1; mode=block"

# Prevent MIME type sniffing
Header always append X-Content-Type-Options "nosniff"

# Content Security Policy (basic)
Header set Content-Security-Policy "default-src 'self' https:; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https:;"

# Referrer Policy
Header set Referrer-Policy "strict-origin-when-cross-origin"

# Feature Policy (Permissions Policy)
Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

# Remove server signature
Header always unset X-Powered-By
Header unset X-Powered-By

# ============================================================================
# SEO Optimizations
# ============================================================================

# Add canonical header (optional, already in HTML)
# Header set Link "<https://vedhaai.in>; rel=\"canonical\""

# Ensure proper character set
AddCharset UTF-8 .html .css .js .xml .json

# ============================================================================
# File Type Headers
# ============================================================================

# HTML - No cache
<FilesMatch "\.html?$">
  Header set Cache-Control "max-age=0, must-revalidate, no-cache, no-store"
  Header set Expires "Wed, 21 Oct 2015 07:28:00 GMT"
</FilesMatch>

# JavaScript/CSS - Cache for 1 month with cache busting in filenames
<FilesMatch "\.(js|css)$">
  Header set Cache-Control "public, max-age=2592000, immutable"
  Header set Expires "access plus 1 month"
</FilesMatch>

# Media files - Cache for 1 year
<FilesMatch "\.(jpg|jpeg|png|gif|ico|svg|webp)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
  Header set Expires "access plus 1 year"
</FilesMatch>

# Fonts - Cache for 1 year
<FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
  Header set Expires "access plus 1 year"
  AddType font/woff2 .woff2
  AddType font/woff .woff
</FilesMatch>

# ============================================================================
# Access Control - Block unwanted access
# ============================================================================

# Deny access to hidden files and directories
<FilesMatch "^\.|^#.*#|~$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Block access to sensitive files
<FilesMatch "\.(env|config|ini|log|sql|git|gitignore|md|txt)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Block access to node_modules
<DirectoryMatch "^.*\/node_modules">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</DirectoryMatch>

# ============================================================================
# MIME Types
# ============================================================================
AddType application/json .json
AddType text/plain .txt
AddType application/xml .xml
AddEncoding gzip .gz

# ============================================================================
# Error and Index Pages
# ============================================================================
DirectoryIndex index.html index.htm

# Custom error pages (optional)
# ErrorDocument 404 /404.html
# ErrorDocument 500 /500.html

# ============================================================================
# Performance - Disable directory listing
# ============================================================================
<Directory />
  Options -Indexes
</Directory>

# ============================================================================
# CORS Headers (if serving from CDN or cross-origin requests)
# ============================================================================
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
  Header set Access-Control-Allow-Headers "Content-Type, Authorization"
</IfModule>

# ============================================================================
# Prevent hotlinking (optional - uncomment to enable)
# ============================================================================
# RewriteCond %{HTTP_REFERER} !^$
# RewriteCond %{HTTP_REFERER} !^https?://(www\.)?vedhaai\.in [NC]
# RewriteRule \.(jpg|jpeg|png|gif|css|js)$ - [NC,F,L]

# ============================================================================
# Redirect old pages to new URLs (if applicable)
# ============================================================================
# Redirect 301 /old-page /new-page

# ============================================================================
# ETags for cache validation
# ============================================================================
<IfModule mod_headers.c>
  Header unset ETag
  FileETag None
</IfModule>

# ============================================================================
# End of VedhaAI .htaccess Configuration
# ============================================================================